<?xml version="1.0" encoding="UTF-8"?>

<included>

    <property
            name="CONSOLE_LOG_PATTERN"
            value="%cyan(%d{yyyy-MM-dd HH:mm:ss.SSS})
                   %highlight(%-5level)
                   [%X{traceId:-}]
                   %green(%logger{36})
                   - %msg%n"/>

</included>